{% extends "base.html" %}
{% block title %}台股每日行情{% endblock %}

{% block content %}
<h1 class="page-title">台股每日行情匯總</h1>

<!-- 即時大盤 widget (從 today.json 動態載入) -->
<div id="today-widget" style="display:none">
  <div class="today-header">
    <span id="tw-date"></span>
    <span id="tw-badge" class="today-badge"></span>
    <span id="tw-time" style="color:var(--text-muted);font-size:12px;margin-left:auto"></span>
  </div>
  <div class="today-grid">
    <div class="today-card">
      <div class="today-card-label">加權指數 <span id="tw-taiex-date" class="card-date-tag"></span></div>
      <div id="tw-close" class="today-card-value"></div>
      <div id="tw-change" class="today-card-sub"></div>
    </div>
    <div class="today-card">
      <div class="today-card-label">成交金額 <span id="tw-amount-date" class="card-date-tag"></span></div>
      <div id="tw-amount" class="today-card-value"></div>
      <div id="tw-txn" class="today-card-sub" style="color:var(--text-muted)"></div>
    </div>
    <div class="today-card" id="card-twse">
      <div class="today-card-label" id="lbl-twse">上市漲跌</div>
      <div id="tw-bar-twse" class="tw-bar-row"></div>
      <div id="tw-breadth-twse"></div>
    </div>
    <div class="today-card" id="card-tpex">
      <div class="today-card-label" id="lbl-tpex">上櫃漲跌</div>
      <div id="tw-bar-tpex" class="tw-bar-row"></div>
      <div id="tw-breadth-tpex"></div>
    </div>
  </div>
</div>

{% if reports %}
{% set latest = reports[0] %}
<div class="latest-banner">
  <div>
    <div class="latest-label">最新報告</div>
    <a href="reports/{{ latest.date }}.html">{{ latest.date }} 收盤行情</a>
  </div>
  <div style="color:var(--text-muted);font-size:12px;margin-left:auto">
    更新於 {{ latest.generated_at }}
  </div>
</div>
{% endif %}

<table class="archive-table">
  <thead>
    <tr><th>日期</th><th>產生時間</th><th>連結</th></tr>
  </thead>
  <tbody>
    {% for r in reports %}
    <tr>
      <td>{{ r.date }}</td>
      <td style="color:var(--text-muted);font-size:13px">{{ r.generated_at }}</td>
      <td><a href="reports/{{ r.date }}.html">查看報告</a></td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if not reports %}
<div style="color:var(--text-muted);padding:40px 0;text-align:center">
  尚無報告，請執行 <code>python update.py</code> 產生今日報告。
</div>
{% endif %}

<div style="margin-top:32px;color:var(--text-muted);font-size:12px">
  資料來源：臺灣證券交易所 (TWSE) · 證券櫃檯買賣中心 (TPEX)
</div>
{% endblock %}

{% block extra_js %}
<style>
.today-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  font-size: 15px;
  font-weight: 600;
}
.today-badge {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 10px;
  background: var(--pos);
  color: #fff;
}
.today-badge.partial { background: var(--text-muted); }
.card-date-tag {
  font-size: 10px;
  font-weight: 400;
  color: var(--text-muted);
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 1px 5px;
  vertical-align: middle;
  margin-left: 4px;
  letter-spacing: 0;
}
.today-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}
.today-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 14px 16px;
}
.today-card-label { font-size: 11px; color: var(--text-muted); margin-bottom: 6px; }
.today-card-value { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; }
.today-card-sub   { font-size: 13px; margin-top: 4px; }

/* 色條（對齊 report breadth-bar-row） */
.tw-bar-row {
  display: flex;
  height: 6px;
  border-radius: 3px;
  overflow: hidden;
  margin: 8px 0 10px;
  gap: 1px;
}
.tw-bar-up   { background: var(--pos); border-radius: 3px 0 0 3px; }
.tw-bar-flat { background: var(--flat); opacity: 0.4; }
.tw-bar-down { background: var(--neg); border-radius: 0 3px 3px 0; }

/* 漲跌明細列（對齊 report .breadth-row） */
.tw-brow {
  display: flex;
  align-items: center;
  padding: 3px 0;
  font-size: 13px;
  gap: 6px;
}
.tw-brow + .tw-brow { border-top: 1px solid var(--border); }
.tw-brow.divider { margin-top: 4px; border-top: 1px dashed var(--border) !important; }
.tw-blabel { color: var(--text-muted); width: 28px; flex-shrink: 0; }
.tw-bval   { font-weight: 700; min-width: 38px; text-align: right; font-variant-numeric: tabular-nums; }
.tw-bpct   { color: var(--text-muted); font-size: 11px; margin-left: auto; }

#today-widget { margin-bottom: 28px; }
</style>
<script>
(function() {
  function fmt(n, d) {
    return Number(n).toLocaleString('zh-TW', {minimumFractionDigits: d == null ? 0 : d, maximumFractionDigits: d == null ? 0 : d});
  }
  function pctStr(p, d) { return (p >= 0 ? '+' : '') + fmt(p, d == null ? 2 : d) + '%'; }
  function posNeg(n) { return n > 0 ? 'pos' : n < 0 ? 'neg' : 'flat'; }

  fetch('./today.json?_=' + Date.now())
    .then(r => r.ok ? r.json() : null)
    .catch(() => null)
    .then(d => {
      if (!d || !d.taiex) return;

      // header
      document.getElementById('tw-date').textContent = d.date + ' 盤後快訊';
      const badge = document.getElementById('tw-badge');
      if (d.complete) { badge.textContent = '完整版'; badge.className = 'today-badge'; }
      else            { badge.textContent = '更新中'; badge.className = 'today-badge partial'; }
      document.getElementById('tw-time').textContent = '資料時間 ' + d.generated_at;

      // date tags on cards
      const dateTag = d.date;
      ['tw-taiex-date', 'tw-amount-date'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.textContent = dateTag;
      });

      // taiex
      const t = d.taiex;
      const cc = posNeg(t.change_pts);
      document.getElementById('tw-close').innerHTML =
        '<span class="' + cc + '">' + fmt(t.close, 2) + '</span>';
      document.getElementById('tw-change').innerHTML =
        '<span class="' + cc + '">' + (t.change_pts >= 0 ? '▲' : '▼') + ' ' +
        fmt(Math.abs(t.change_pts), 2) + '　' + pctStr(t.change_pct) + '</span>';
      document.getElementById('tw-amount').textContent = fmt(t.trading_amount_yi, 0) + ' 億';
      document.getElementById('tw-txn').textContent = fmt(t.transaction_count) + ' 筆';

      // breadth card
      function renderBreadth(barId, rowId, lblId, b, label) {
        if (!b || !b.total) return;
        document.getElementById(lblId).innerHTML = label + '（共 ' + fmt(b.total) + ' 支）' +
          ' <span class="card-date-tag">' + dateTag + '</span>';
        // color bar
        document.getElementById(barId).innerHTML =
          '<div class="tw-bar-up" style="flex:' + b.up + '"></div>' +
          '<div class="tw-bar-flat" style="flex:' + b.flat + '"></div>' +
          '<div class="tw-bar-down" style="flex:' + b.down + '"></div>';
        // rows
        function row(label, val, pct, colorCls, extra) {
          return '<div class="tw-brow' + (extra || '') + '">' +
            '<span class="tw-blabel">' + label + '</span>' +
            '<span class="tw-bval ' + colorCls + '">' + fmt(val) + '</span>' +
            '<span class="tw-bpct">' + fmt(pct, 1) + '%</span>' +
            '</div>';
        }
        document.getElementById(rowId).innerHTML =
          row('上漲', b.up,         b.up_pct,         'pos') +
          row('下跌', b.down,       b.down_pct,       'neg') +
          row('持平', b.flat,       b.flat_pct,       'flat') +
          row('漲停', b.limit_up,   b.limit_up_pct,   'pos', ' divider') +
          row('跌停', b.limit_down, b.limit_down_pct, 'neg');
      }
      renderBreadth('tw-bar-twse', 'tw-breadth-twse', 'lbl-twse', d.breadth && d.breadth.twse, '上市漲跌');
      renderBreadth('tw-bar-tpex', 'tw-breadth-tpex', 'lbl-tpex', d.breadth && d.breadth.tpex, '上櫃漲跌');

      document.getElementById('today-widget').style.display = 'block';
    });
})();
</script>
{% endblock %}
